rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pageData/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /adminAuth/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /contacts/{document} {
      allow read, write: if true;
    }
  }
}

